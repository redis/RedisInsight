# Retain yarn-equivalent peer dependency resolution.
# @elastic/eui@34.6.0 declares legacy peer deps (e.g. @types/react@^16)
# that conflict with React 18. This is a known issue being resolved as the
# project migrates away from @elastic/eui to @redis-ui/components.
legacy-peer-deps=true

# Supply-chain guard: only install package versions published at least N days ago.
# Mirrors dependabot's cooldown (.github/dependabot.yml). Maps to npm's --before.
min-release-age=3

# @redislabsdev/rdi-ui is published to GitHub Packages, not the public npm
# registry. The registry URL is not a secret — the credential is supplied via
# the NPM_AUTH_TOKEN environment variable and is never committed.
#
# The dependency itself resolves from a local yalc link (see RDI_README.md), so
# this registry is only consulted for the library's own transitive dependency
# @redislabsdev/rdi-sdk. Contributors without the yalc link never reach it.
@redislabsdev:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${NPM_AUTH_TOKEN}
